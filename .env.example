# ─── Database (PostgreSQL) ──────────────────────────────────
# Local dev with docker-compose: matches the `db` service.
DATABASE_URL="postgresql://kuxtal:kuxtal_dev@localhost:5432/kuxtal?schema=public"

# Production examples:
#   Neon:     postgresql://USER:PASS@ep-xxxx.us-east-2.aws.neon.tech/kuxtal?sslmode=require
#   Supabase: postgresql://postgres:PASS@db.xxxx.supabase.co:5432/postgres?sslmode=require
#   Render PG: provided by the dashboard (Internal Database URL)

# ─── Auth ───────────────────────────────────────────────────
# Generate a strong secret: `openssl rand -hex 64`
JWT_SECRET="change-me-locally-and-never-commit"
JWT_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated origins. Use "*" only for local dev.
# Production must list each frontend origin explicitly:
#   https://your-app.vercel.app,https://www.kuxtal.example
CORS_ORIGINS="http://localhost:5173,http://localhost:8080"

# ─── Web Push (VAPID) ───────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key-here"
VAPID_PRIVATE_KEY="your-vapid-private-key-here"
VAPID_SUBJECT="mailto:admin@kuxtal.example"

# ─── Optional bootstrap admin ──────────────────────────────
# Used on first startup if no admin user exists. Defaults: admin/admin.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong
# ADMIN_EMAIL=admin@kuxtal.example
