# Backend production env — paste these into Render's "Environment" tab.
# Do NOT commit a filled-in copy. This file is only a template.

# Required
DATABASE_URL=
JWT_SECRET=
CORS_ORIGINS=https://your-app.vercel.app

# Optional (sensible defaults exist)
JWT_EXPIRES_IN=7d
NODE_ENV=production
# PORT is injected by Render; no need to set unless overriding.

# Optional bootstrap admin (used by the auto-seed on first start)
# Defaults to admin/admin if you do not set these.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong
# ADMIN_EMAIL=admin@kuxtal.example
